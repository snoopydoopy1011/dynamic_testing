// ==================== UTILITY FUNCTIONS ====================

f_getSize(s) =>
     s == "tiny"   ? size.tiny  :
     s == "small"  ? size.small :
     s == "normal" ? size.normal:
                     size.large

f_getTableSize(s) =>
     s == "tiny"   ? size.tiny  :
     s == "small"  ? size.small :
     s == "normal" ? size.normal:
                     size.large

// ============================================================================
// PHASE 1.1: AUTO-DETECTION LOGIC EXTRACTION (STEP 3)
// Source: Options_volume_main_current.pine lines 198-214
// CRITICAL: Symbol detection chain - autoDetectedSPX → effectiveIsSpx → spacing
// ============================================================================

// ──────── COMPUTED VARIABLES ────────────────────────────────────────────────────────

// Auto-detect SPX and automatically use SPXW as the ticker for options
autoDetectedSPX = syminfo.ticker == "SPX"
// Either use custom symbol if checked, or use SPXW for SPX, otherwise use current ticker
tickerSymbol = useCustomSymbol ? customBaseSymbol : (autoDetectedSPX ? "SPXW" : syminfo.ticker)

// Auto-determine if we're in SPX mode (either manually checked or auto-detected)
effectiveIsSpx = isSpx or autoDetectedSPX or syminfo.ticker == "SPXW"
// Add these variables to get the effective date to use
effectiveYear = useCurrentDate ? year : yearInput
effectiveMonth = useCurrentDate ? month : monthInput
effectiveDay = useCurrentDate ? dayofmonth : dayInput

// Use proper values based on whether we're in SPX mode
// When in SPX mode, use spxRounding for all values
effectiveRoundStrike = effectiveIsSpx ? spxRounding : roundStrikeInput
effectiveSpacing = effectiveIsSpx ? spxRounding : strikeSpacingInput

