        symbolText := customSymbolPrefix + underlyingSymbol + yy + mm + dd + _side + customStrikeStr + customSymbolSuffix
    else
        // STANDARD OSI FORMATTING (Required for TradingView Volume)
        // 1. Convert strike to integer representation (multiply by 1000)
        strikeInt = math.round(strikePrice * 1000)
        
        // 2. Convert to string
        rawStrike = str.tostring(strikeInt)
        
        // 3. Pad with leading zeros to ensure 8 digits total
        padCount = math.max(0, 8 - str.length(rawStrike))
        strikePad = padCount > 0 ? str.repeat("0", padCount) + rawStrike : rawStrike
        
        // 4. Construct final symbol: Ticker + YYMMDD + Side + PaddedStrike
        symbolText := baseSymbol + yy + mm + dd + _side + strikePad
    
    symbolText

