// --- CONSOLIDATED Proximity Tracking System ---
calculateSignalProximity(context, isDiverging, divStrength, intensityMult, pinRisk, gexDelta) =>
    // Create a new, local map for this calculation
    _proximityMap = map.new<string, float>()

    // --- 1. Explosive Calculation (formerly its own function) ---
    intensityProx = math.min(intensityMult / 2.0, 1.0)
    divergenceProx = isDiverging ? 1.0 : 0.0
    contextProxExplosive = context == "HIGH_GAMMA+VOLATILE" ? 1.0 : (context == "HIGH_GAMMA+QUIET" ? 0.7 : 0.5)
    
    explosiveProximity = 0.0
    if intensityProx >= 0.25 and divergenceProx >= 0.25 and contextProxExplosive >= 0.25
        weakestLink = math.min(intensityProx, math.min(divergenceProx, contextProxExplosive))
        synergyBoost = (intensityProx + divergenceProx + contextProxExplosive) / 3.0 * 0.2
        explosiveProximity := math.min(weakestLink + synergyBoost, 1.0)
    map.put(_proximityMap, "EXPLOSIVE", explosiveProximity)

    // --- 2. Breakout Calculation (formerly its own function) ---
    divProx = math.min(divStrength / 1.5, 1.0)
    contextProxBreakout = context == "LOW_GAMMA+VOLATILE" ? 1.0 : 0.6
    
    breakoutProximity = 0.0
    if divProx >= 0.25 and contextProxBreakout >= 0.25
        weakestLink = math.min(divProx, contextProxBreakout)
        synergyBoost = (isDiverging ? 1.0 : 0.0) * 0.2
        breakoutProximity := math.min(weakestLink + synergyBoost, 1.0)
    map.put(_proximityMap, "BREAKOUT", breakoutProximity)

    // --- 3. Pin Risk Calculation (formerly its own function) ---
    intensityProxPin = math.min(intensityMult / 3.0, 1.0)
    pinProx = math.min(pinRisk / 1000.0, 1.0)
    
    pinRiskProximity = 0.0
    if intensityProxPin > 0 and pinProx > 0
        pinRiskProximity := math.avg(intensityProxPin, pinProx) * 1.1
    map.put(_proximityMap, "PIN_RISK", pinRiskProximity)

    // --- 4. Fade Calculation (formerly its own function) ---
    contextProxFade = context == "HIGH_GAMMA+QUIET" ? 1.0 : 0.4
    gexProx = math.min(math.abs(gexDelta) / 2000000.0, 1.0)
    
    fadeProximity = 0.0
    if contextProxFade >= 0.25 and gexProx >= 0.25
        fadeProximity := math.min(contextProxFade, gexProx)
    map.put(_proximityMap, "FADE", fadeProximity)

    // Return the single, populated map
    _proximityMap

