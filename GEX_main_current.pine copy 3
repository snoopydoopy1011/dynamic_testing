// Apply state hysteresis to prevent flicker
applyStateHysteresis(targetState, currentState, _currentChangeCounter, _currentHoldCounter) =>
    // Directional hysteresis thresholds
    upgradeThreshold = 2      // 2 bars to move to higher priority state
    downgradeThreshold = 5    // 5 bars to move to lower priority state  
    stateHoldMinimum = 3      // Minimum bars to hold any state
    
    // Get priority levels for current and target states
    currentPriority = getStatePriority(currentState)
    targetPriority = getStatePriority(targetState)
    
    // Initialize the new state and counters with the current values
    newState = currentState
    newChangeCounter = _currentChangeCounter
    newHoldCounter = _currentHoldCounter
    
    if targetState == currentState
        // Same state - reset change counter and increment hold counter
        newChangeCounter := 0
        newHoldCounter := _currentHoldCounter + 1
    else
        // Different state - increment the change counter to see if we should switch
        newChangeCounter := _currentChangeCounter + 1
        
        // Determine required threshold based on direction
        requiredThreshold = targetPriority > currentPriority ? upgradeThreshold : downgradeThreshold
        
        // Change state if threshold met AND minimum hold time satisfied
        if newChangeCounter >= requiredThreshold and _currentHoldCounter >= stateHoldMinimum
            newState := targetState
            newChangeCounter := 0 // Reset counters on a successful state change
            newHoldCounter := 0
        // else: newState remains the same, and the counters keep their updated values for the next bar.
        
    // Return all the new values as a tuple
    [newState, newChangeCounter, newHoldCounter]


