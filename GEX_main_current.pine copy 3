// Smart number formatting with M/B/T scaling
formatLargeNumber(value) =>
    if na(value)
        "N/A"
    else if math.abs(value) >= 1000000000000  // Trillions
        str.tostring(value / 1000000000000, '#.#') + "T"
    else if math.abs(value) >= 1000000000     // Billions  
        str.tostring(value / 1000000000, '#.#') + "B"
    else if math.abs(value) >= 1000000        // Millions
        str.tostring(value / 1000000, '#.#') + "M"
    else if math.abs(value) >= 1000           // Thousands
        str.tostring(value / 1000, '#.#') + "K"
    else
        str.tostring(value, '#.#')

