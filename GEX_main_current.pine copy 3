    table.clear(strikeTable, 0, 0, 3, strikesToShow)

    table.cell(strikeTable, 0, 0, 'Strike', text_color = color.white, bgcolor = color.new(color.blue, 50), text_size = size.normal)
    table.cell(strikeTable, 1, 0, 'Call OI', text_color = color.white, bgcolor = color.new(color.blue, 50), text_size = size.normal)
    table.cell(strikeTable, 2, 0, 'Put OI', text_color = color.white, bgcolor = color.new(color.blue, 50), text_size = size.normal)
    table.cell(strikeTable, 3, 0, 'Net Gamma', text_color = color.white, bgcolor = color.new(color.blue, 50), text_size = size.normal)

    sortedIndices = array.sort_indices(strikes, order.descending)
    sortedStrikes = array.new_float(0)
    sortedCallOI = array.new_float(0)
    sortedPutOI = array.new_float(0)
    sortedNetGamma = array.new_float(0)
    
    for i = 0 to array.size(sortedIndices) - 1
        idx = array.get(sortedIndices, i)
        array.push(sortedStrikes, array.get(strikes, idx))
        array.push(sortedCallOI, array.get(callOI, idx))
        array.push(sortedPutOI, array.get(putOI, idx))
        array.push(sortedNetGamma, array.get(netGamma, idx))
    
    atmIndex = 0
    minDiff = 1e9
    for i = 0 to array.size(sortedStrikes) - 1
        diff = math.abs(array.get(sortedStrikes, i) - currentPrice)
        if diff < minDiff
            minDiff := diff
            atmIndex := i
    
    strikesPerSide = math.floor(strikesToShow / 2)
    startIdx = math.max(0, atmIndex - strikesPerSide)
    endIdx = math.min(array.size(sortedStrikes) - 1, atmIndex + strikesPerSide)
    
    if startIdx == 0 and endIdx < array.size(sortedStrikes) - 1
        endIdx := math.min(array.size(sortedStrikes) - 1, startIdx + strikesToShow - 1)
    else if endIdx == array.size(sortedStrikes) - 1 and startIdx > 0
        startIdx := math.max(0, endIdx - strikesToShow + 1)
    
    displayRows = math.min(endIdx - startIdx + 1, strikesToShow)
    
    for i = 0 to displayRows - 1
        tableRow = i + 1
        dataIdx = startIdx + i
        
        if dataIdx <= endIdx
            strike = array.get(sortedStrikes, dataIdx)
            callOIVal = array.get(sortedCallOI, dataIdx)
            putOIVal = array.get(sortedPutOI, dataIdx)
            netGammaVal = array.get(sortedNetGamma, dataIdx)
            
            // PHASE 3: Enhanced Strike Highlighting with Key Level Detection
            isATM = dataIdx == atmIndex
            isMagnetStrike = not na(magnetStrike) and math.abs(strike - magnetStrike) < 0.01
            isPinStrike = not na(strongestPinStrike) and math.abs(strike - strongestPinStrike) < 0.01
            isSameStrike = isMagnetStrike and isPinStrike
            
            // Enhanced formatting with icons - consistent with collision system
            strikeStr = if isSameStrike and enablePinGammaCollision
                // Use same collision detection and formatting as main labels
                if checkPinRiskGammaMagnetCollision(strongestPinStrike, magnetStrike)
                    getCombinedPinGammaLabelText(strike, pinGammaLabelStyle)
                else
                    "🧲📍 " + str.tostring(strike, "#.##")  // Fallback
            else if isMagnetStrike  
                "🧲 " + str.tostring(strike, "#.##")    // Gamma Magnet only
            else if isPinStrike
                "📍 " + str.tostring(strike, "#.##")    // Pin Risk only
            else
                str.tostring(strike, "#.##")            // Normal strike
            
            // Enhanced background color based on highlighting priority
            highlightBgColor = if isSameStrike
                getRelationshipColor(relationshipStatus)  // Use relationship color for same strike
            else if isMagnetStrike
                color.new(color.purple, 30)              // Magnet purple
            else if isPinStrike  
                color.new(color.blue, 30)                // Pin blue
            else if isATM
                color.new(color.orange, 40)              // ATM orange
            else
                color.new(color.gray, 70)                // Normal gray
            
            // Format other columns
            callOIStr = str.tostring(callOIVal, "#,###")
            putOIStr = str.tostring(putOIVal, "#,###")
            netGammaStr = str.tostring(netGammaVal, "#,###.##")
            
            netGammaColor = netGammaVal >= 0 ? color.new(positiveColor, 0) : color.new(negativeColor, 0)
            
            // Apply enhanced highlighting to all cells in the row
            table.cell(strikeTable, 0, tableRow, strikeStr, bgcolor = highlightBgColor, text_color = color.white, text_size = size.normal)
            table.cell(strikeTable, 1, tableRow, callOIStr, bgcolor = highlightBgColor, text_color = color.white, text_size = size.normal)
