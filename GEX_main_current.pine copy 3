updateSessionBaseline(currentVol, currentGexDelta, currentTimeIntensity, currentSessionBarCount, currentSessionStartTime, currentSessionIsWarmedUp) =>
    // Get market session information using new time-based functions
    [inTradingHours, minutesSinceOpen, isNewSession, spotterShouldBeActive, sessionProgress] = getMarketSessionInfo()
    
    // Use time-based session tracking instead of bar counting
    newSessionBarCount = currentSessionBarCount + 1  // Keep for backwards compatibility
    newSessionStartTime = currentSessionStartTime
    newSessionIsWarmedUp = currentSessionIsWarmedUp
    
    // Initialize session metrics on new trading session (not just first bar after chart reset)
    if isNewSession and inTradingHours
        newSessionStartTime := time
        map.put(sessionMetrics, "avgVolatility", currentVol)
        map.put(sessionMetrics, "avgGexDelta", math.abs(currentGexDelta))
        map.put(sessionMetrics, "avgTimeIntensity", currentTimeIntensity)
        // Reset warm-up for actual new sessions
        newSessionIsWarmedUp := false
    
    // Use time-based session progress instead of bar counting
    // sessionProgress is already calculated in getMarketSessionInfo() (0 to 1 over first hour)
    
    // Dual-EMA: Fast adaptation early, stable adaptation later
    fastAlpha = 2.0 / (10 + 1)  // 10-period EMA for first hour responsiveness
    slowAlpha = 2.0 / (60 + 1)  // 60-period EMA for session stability
    
    // Crossfade between fast and slow adaptation based on time-based session progress
    currentAlpha = if enableDualEMA and not na(sessionProgress)
        fastAlpha * (1 - sessionProgress) + slowAlpha * sessionProgress
    else
        // Fallback to bar-based logic if time calculation fails
        2.0 / (newSessionBarCount + 1)
    
    // 0DTE exponential time decay curve
    hoursToExpiry = calculateHoursToExpiry()
    timeIntensityMultiplier = hoursToExpiry <= 2.0 ? 
                             math.pow(4.0, (2.0 - hoursToExpiry) / 2.0) : 1.0
    
    // Power Hour detection (3-4 PM ET)
    currentHour = hour(time, "America/New_York")
    isPowerHour = currentHour >= 15 and currentHour < 16
    powerHourMultiplier = isPowerHour ? 1.3 : 1.0
    
    // Enhanced time intensity with 0DTE and power hour effects
    enhancedTimeIntensity = currentTimeIntensity * timeIntensityMultiplier * powerHourMultiplier
    
    // Update baselines with enhanced alpha
    currentAvgVol = map.get(sessionMetrics, "avgVolatility")
    currentAvgGex = map.get(sessionMetrics, "avgGexDelta")
    currentAvgIntensity = map.get(sessionMetrics, "avgTimeIntensity")
    
    // Only update if we have existing values (prevents na errors)
    if not na(currentAvgVol) and not na(currentAvgGex) and not na(currentAvgIntensity)
        map.put(sessionMetrics, "avgVolatility", currentAvgVol * (1 - currentAlpha) + currentVol * currentAlpha)
        map.put(sessionMetrics, "avgGexDelta", currentAvgGex * (1 - currentAlpha) + math.abs(currentGexDelta) * currentAlpha)
        map.put(sessionMetrics, "avgTimeIntensity", currentAvgIntensity * (1 - currentAlpha) + enhancedTimeIntensity * currentAlpha)
    
    // TIME-BASED WARM-UP: Mark as warmed up after 5 minutes of market time (CHART RESET RESILIENT)
    if not newSessionIsWarmedUp and inTradingHours and not na(minutesSinceOpen)
        stabilityThreshold = 0.2 // 20% change tolerance (more lenient)
        // Use time-based warm-up (5 minutes) instead of bar counting
        timeBasedWarmUp = minutesSinceOpen >= 5
        
        // Optional: Add stability check as backup (only if we have sufficient data)
        stabilityBasedWarmUp = false
        if not na(currentAvgVol) and currentAvgVol > 0 and newSessionBarCount >= 5
            stabilityBasedWarmUp = math.abs(currentVol - currentAvgVol) / currentAvgVol < stabilityThreshold
        
        if timeBasedWarmUp or stabilityBasedWarmUp
            newSessionIsWarmedUp := true
    
    // Return updated values
    [newSessionBarCount, newSessionStartTime, newSessionIsWarmedUp]



