findZeroGammaLevel(strikes, netGamma, currentPrice) =>
    if array.size(strikes) < 2 or array.size(netGamma) < 2
        na
    else
        // 1. Sort data to ensure we compare adjacent strikes
        indices = array.sort_indices(strikes, order.ascending)
        sortedStrikes = array.new_float(0)
        sortedNetGamma = array.new_float(0)
        
        for i = 0 to array.size(indices) - 1
            idx = array.get(indices, i)
            array.push(sortedStrikes, array.get(strikes, idx))
            array.push(sortedNetGamma, array.get(netGamma, idx))
        
        float closestZeroPrice = na
        float minDistance = 1e9
        
        // 2. Scan for sign flips between adjacent strikes
        for i = 0 to array.size(sortedNetGamma) - 2
            g1 = array.get(sortedNetGamma, i)
            g2 = array.get(sortedNetGamma, i+1)
            
            // Check if one is positive and the other is negative
            if (g1 >= 0 and g2 < 0) or (g1 < 0 and g2 >= 0)
                s1 = array.get(sortedStrikes, i)
                s2 = array.get(sortedStrikes, i+1)
                
                // 3. Linear Interpolation to find the exact "Zero" price between the two strikes
                // Formula: zeroPrice = s1 - g1 * (s2 - s1) / (g2 - g1)
                denom = g2 - g1
                if denom != 0
                    zeroPrice = s1 - (g1 * (s2 - s1) / denom)
                    
                    // 4. Find the flip closest to current price (handles multiple flips)
                    dist = math.abs(zeroPrice - currentPrice)
                    if dist < minDistance
                        minDistance := dist
                        closestZeroPrice := zeroPrice
        
        closestZeroPrice

