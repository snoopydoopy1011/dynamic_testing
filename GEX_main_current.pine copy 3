createConfidenceGradient(confidenceScore) =>
    // Convert confidence (0-100) to 5-bar visual representation
    normalizedScore = math.max(0.0, math.min(100.0, confidenceScore))
    filledBars = math.round(normalizedScore / 20.0) // 0-5 bars
    emptyBars = 5 - filledBars
    
    // Use different characters for filled vs empty
    filledChar = "█"
    emptyChar = "░"
    
    confidenceBar = str.repeat(filledChar, filledBars) + str.repeat(emptyChar, emptyBars)
    confidenceBar

