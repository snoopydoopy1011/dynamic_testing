getUnifiedHorizontalOffset(price, priceArr, offsetArr, countArr, maxOffset, useOffset) =>
    if not useOffset
        0
    else
        index = -1
        
        // Search for existing price level within 1 tick tolerance
        if array.size(priceArr) > 0
            for i = 0 to array.size(priceArr) - 1
                if math.abs(array.get(priceArr, i) - price) < syminfo.mintick
                    index := i
                    break
        
        if index >= 0
            // Found existing price - increment collision count
            count = array.get(countArr, index) + 1
            array.set(countArr, index, count)
            
            // Calculate offset using modulo to cycle through available positions
            offset = count % maxOffset
            array.set(offsetArr, index, offset)
            offset
        else
            // New price level - add to tracking arrays
            array.push(priceArr, price)
            array.push(countArr, 1)
            array.push(offsetArr, 0)
            0  // First label at this price gets offset 0

