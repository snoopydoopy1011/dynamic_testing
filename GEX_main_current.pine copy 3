// Global variables for velocity tracking and emergency detection

// 4.1 Velocity Indicators for State Dynamics
calculateProximityVelocity(currentProximity, signalType) =>
    // Initialize history array for signal type if needed
    if not map.contains(proximityHistory, signalType)
        historyData = ProximityHistoryData.new(array.new<float>())
        map.put(proximityHistory, signalType, historyData)
    
    historyData = map.get(proximityHistory, signalType)
    history = historyData.history
    array.push(history, currentProximity)
    
    // Keep last 5 bars for velocity calculation
    if array.size(history) > 5
        array.shift(history)
    
    // Calculate velocity (change over 3 bars)
    if array.size(history) >= 3
        recent = array.get(history, array.size(history) - 1)
        older = array.get(history, array.size(history) - 3)
        velocity = (recent - older) / 3.0
        
        // Calculate acceleration (change in velocity)
        if array.size(history) >= 4
            prevRecent = array.get(history, array.size(history) - 2)
            prevOlder = array.get(history, array.size(history) - 4)
            prevVelocity = (prevRecent - prevOlder) / 3.0
            acceleration = velocity - prevVelocity
            [velocity, acceleration]
        else
            [velocity, 0.0]
    else
        [0.0, 0.0]

