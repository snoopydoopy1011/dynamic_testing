// v4.2 NEW: Calculate Dynamic Dealer Hedge Efficiency based on Volume/OI ratio
// Replaces static 0.75 with real-time hedge activity measurement
calculateDealerHedgeEfficiency(callVolumes, putVolumes, callOI, putOI) =>
    if array.size(callVolumes) == 0 or array.size(callOI) == 0
        0.75  // Fallback to default
    else
        totalCallVolume = array.sum(callVolumes)
        totalPutVolume = array.sum(putVolumes) 
        totalCallOI = array.sum(callOI)
        totalPutOI = array.sum(putOI)
        
        // Calculate Volume/OI ratios
        callVoOI = totalCallOI > 0 ? totalCallVolume / totalCallOI : 0.0
        putVoOI = totalPutOI > 0 ? totalPutVolume / totalPutOI : 0.0
        
        // Combined hedge activity metric
        // High Volume/OI ratio = active hedging (efficiency near 1.0)
        // Low Volume/OI ratio = passive positions (efficiency near 0.3)
        averageVoOI = (callVoOI + putVoOI) / 2.0
        
        // Map Volume/OI ratio to efficiency (0.3 to 1.0 range)
        // Typical ranges: 0.1-0.5 = low activity, 0.5-2.0 = high activity
        normalizedRatio = math.min(2.0, math.max(0.1, averageVoOI))
        dynamicEfficiency = 0.3 + (normalizedRatio / 2.0) * 0.7  // Scale 0.3-1.0
        
        // Bounds check for safety
        math.min(1.0, math.max(0.3, dynamicEfficiency))

