        for i = 0 to array.size(bk_lLevels) - 1 by 1
            // For line coordinates - use time for lines, bar_index for labels
            x1 = bk_dateTs + math.round(array.get(bk_lStartOffsets, i) * bk_hourMs)
            x2 = bk_dateTs + math.round(array.get(bk_lEndOffsets, i) * bk_hourMs)
            y = array.get(bk_lLevels, i)
