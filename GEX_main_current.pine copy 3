// Enhanced Normal CDF with better precision
normCDF(x) =>
    if math.abs(x) > 6
        x > 0 ? 1.0 : 0.0
    else
        a1 = 0.254829592
        a2 = -0.284496736
        a3 = 1.421413741
        a4 = -1.453152027
        a5 = 1.061405429
        p = 0.3275911
        sign = x < 0 ? -1.0 : 1.0
        x_abs = math.abs(x) / math.sqrt(2.0)
        t = 1.0 / (1.0 + p * x_abs)
        y = 1.0 - ((((a5 * t + a4) * t + a3) * t + a2) * t + a1) * t * math.exp(-x_abs * x_abs)
        0.5 * (1.0 + sign * y)

// Enhanced d1/d2 calculation with overflow protection
calcD1D2(s, k, r, t, v) =>
    _v = math.max(v, 0.0001)
    _t = math.max(t, 0.0001)
    
    // Protect against extreme values
    if s <= 0 or k <= 0
        [0.0, 0.0]
    else
        logRatio = math.log(s / k)
        if math.abs(logRatio) > 10  // Prevent overflow
            [logRatio > 0 ? 10.0 : -10.0, logRatio > 0 ? 10.0 : -10.0]
        else
            d1 = (logRatio + (r + _v * _v / 2) * _t) / (_v * math.sqrt(_t))
            d2 = d1 - _v * math.sqrt(_t)
            [d1, d2]

// Enhanced Black-Scholes with stability checks
blackScholes(s, k, r, t, v, isCall) =>
    if s <= 0 or k <= 0 or t <= 0 or v <= 0
        0.0
    else
        [d1, d2] = calcD1D2(s, k, r, t, v)
        if isCall
            s * normCDF(d1) - k * math.exp(-r * t) * normCDF(d2)
        else
            k * math.exp(-r * t) * normCDF(-d2) - s * normCDF(-d1)

// Enhanced Gamma calculation with numerical stability
calculateGamma(s, k, r, t, v) =>
    if s <= 0 or k <= 0 or t <= 0 or v <= 0.0001
        0.0
    else
        [d1, d2] = calcD1D2(s, k, r, t, v)
        
        // Check for numerical stability
        if math.abs(d1) > 6
            0.0
        else
            n_prime_d1 = math.exp(-d1 * d1 / 2) / math.sqrt(2 * math.pi)
            sqrtT = math.sqrt(t)
            
            // Additional stability check
            if sqrtT < 1e-10
                0.0
            else
                gamma = n_prime_d1 / (s * v * sqrtT)
                na(gamma) or gamma < 0 or gamma > 1000 ? 0.0 : gamma

// Enhanced Vanna calculation for VIX spike scenarios
calculateVanna(s, k, r, t, v) =>
    if s <= 0 or k <= 0 or t <= 0 or v <= 0.0001
        0.0
    else
        [d1, d2] = calcD1D2(s, k, r, t, v)
        
        // Check for numerical stability
        if math.abs(d1) > 6 or math.abs(d2) > 6
            0.0
        else
            n_prime_d1 = math.exp(-d1 * d1 / 2) / math.sqrt(2 * math.pi)
            vanna = n_prime_d1 * d2 / v
            
            // Stability checks and reasonable bounds
            na(vanna) or math.abs(vanna) > 1000 ? 0.0 : vanna

