// v4.2 NEW: Data Range Warning System
// Check if current price is approaching the edge of the 19-strike data range
checkDataRangeWarning(strikes, currentPrice, threshold) =>
    if array.size(strikes) == 0
        [false, ""]
    else
        highestStrike = array.max(strikes)
        lowestStrike = array.min(strikes)
        
        // Calculate distance to edges in number of strikes (assuming $1 increments for SPY)
        strikeIncrement = 1.0  // Default for SPY - could be made dynamic
        distanceToTop = (highestStrike - currentPrice) / strikeIncrement
        distanceToBottom = (currentPrice - lowestStrike) / strikeIncrement
        
        warningMessage = ""
        isNearEdge = false
        
        // Check if approaching upper edge
        if distanceToTop <= threshold and distanceToTop > 0
            warningMessage := "⚠️ APPROACHING DATA EDGE: " + str.tostring(math.round(distanceToTop)) + " strikes from upper limit (" + str.tostring(highestStrike, "#.##") + ")"
            isNearEdge := true
        // Check if approaching lower edge  
        else if distanceToBottom <= threshold and distanceToBottom > 0
            warningMessage := "⚠️ APPROACHING DATA EDGE: " + str.tostring(math.round(distanceToBottom)) + " strikes from lower limit (" + str.tostring(lowestStrike, "#.##") + ")"
            isNearEdge := true
        // Check if already outside range
        else if currentPrice > highestStrike
            warningMessage := "🚨 OUTSIDE DATA RANGE: Price above upper limit (" + str.tostring(highestStrike, "#.##") + ")"
            isNearEdge := true
        else if currentPrice < lowestStrike
            warningMessage := "🚨 OUTSIDE DATA RANGE: Price below lower limit (" + str.tostring(lowestStrike, "#.##") + ")"
            isNearEdge := true
        
        [isNearEdge, warningMessage]

