// Helper function: Generate compact notation text for same-type collisions
generateCompactText(levelType, currentText, newDescription, showValues = true, showDescriptions = true) =>
    levelPrefix = getLevelTypePrefix(levelType)
    
    // Check if currentText already has compact notation
    if str.startswith(currentText, levelPrefix + "(")
        // Extract existing count and descriptions from compact notation
        colonIndex = str.pos(currentText, "): ")
        if colonIndex > 0
            // Extract count from "BK(3): descriptions"
            countStr = str.substring(currentText, str.length(levelPrefix) + 1, colonIndex)
            existingCount = str.tonumber(countStr)
            descriptionsText = str.substring(currentText, colonIndex + 3)
            
            // Split descriptions and add new one
            existingDescriptions = str.split(descriptionsText, " / ")
            array.push(existingDescriptions, newDescription)
            
            // Build new compact notation with incremented count
            newCount = existingCount + 1
            newPrefix = levelPrefix + "(" + str.tostring(newCount) + "): "
            combinedDescriptions = array.join(existingDescriptions, " / ")
            
            newPrefix + combinedDescriptions
        else
            // Fallback if parsing fails
            currentText + " / " + newDescription
    else
        // First time applying compact notation
        existingDescriptions = str.split(currentText, " / ")
        totalCount = array.size(existingDescriptions) + 1
        
        if totalCount > 1
            // Apply compact notation for multiple same-type levels
            prefix = levelPrefix + "(" + str.tostring(totalCount) + "): "
            
            // Combine descriptions
            array.push(existingDescriptions, newDescription)
            combinedDescriptions = array.join(existingDescriptions, " / ")
            
            prefix + combinedDescriptions
        else
            // Single level, no compact notation needed
            currentText + " / " + newDescription

