            // Gamma decay rate
            gammaDecayValue = gamma * (1 - tomorrowT/timeToExpiry)
            gammaExpiring += math.abs(gammaDecayValue) * oi
            totalOI += oi
        
        // Volatility expansion signal
        volExpansionSignal = gammaExpiring / math.max(totalOI, 1) * 100
        
        [gammaExpiring, volExpansionSignal]

// 4. GAMMA MAGNET DETECTOR - Optimized for 0-1 DTE SPY Day Trading
// This finds the strongest gamma level that will act as a magnet TODAY

detectGammaMagnet(strikes, netGamma, spot, hoursToExpiry) =>
    if array.size(strikes) < 3 or array.size(netGamma) < 3
        [na, 0.0, "No Magnet", 0.0]
    else
        // Find the strongest gamma level within tradeable range
        strongestStrike = spot
        strongestGamma = 0.0
        strongestIdx = -1
        magnetScore = 0.0
        
        // For 0-1 DTE, only care about strikes within realistic daily range
        // SPY typically moves 0.5-1.5% on normal days, 2-3% on volatile days
        maxDistance = hoursToExpiry <= 8 ? 0.01 : 0.02  // 1% for 0DTE, 2% for 1DTE
        
        // Find all significant gamma levels
        gammaLevels = array.new_float(0)
        gammaStrikes = array.new_float(0)
        
        for i = 0 to array.size(strikes) - 1
            strike = array.get(strikes, i)
            gamma = math.abs(array.get(netGamma, i))
            distance = math.abs(strike - spot) / spot
            
            if distance <= maxDistance and gamma > 0
                array.push(gammaStrikes, strike)
                array.push(gammaLevels, gamma)
        
        // Calculate total gamma in range for comparison
        totalGammaInRange = array.sum(gammaLevels)
        
        // Find the dominant level
        if array.size(gammaLevels) > 0
            for i = 0 to array.size(gammaLevels) - 1
                gamma = array.get(gammaLevels, i)
                strike = array.get(gammaStrikes, i)
                
                // Weight by both strength and proximity
                // Closer strikes have more immediate impact for 0DTE
                proximityWeight = 1.0 - (math.abs(strike - spot) / spot / maxDistance)
                weightedGamma = gamma * proximityWeight
                
                if weightedGamma > strongestGamma
                    strongestGamma := weightedGamma
                    strongestStrike := strike
                    
                    // Magnet score: how dominant is this level?
                    if totalGammaInRange > 0
                        magnetScore := gamma / totalGammaInRange
        
        // Determine magnet strength and direction
        magnetStrength = "No Magnet"
        pullDirection = 0.0  // -1 = pulling down, +1 = pulling up
        
        if magnetScore > 0
            // Calculate pull direction
            if strongestStrike > spot
                pullDirection := 1.0  // Magnet above, pulling up
            else if strongestStrike < spot
                pullDirection := -1.0  // Magnet below, pulling down
            
            // Adjust strength description based on score and proximity
            distanceToMagnet = math.abs(strongestStrike - spot) / spot
            
            if magnetScore > 0.5 and distanceToMagnet < 0.005  // >50% gamma within 0.5%
                magnetStrength := "IN THE GRIP"
            else if magnetScore > 0.4
                magnetStrength := "STRONG MAGNET"
            else if magnetScore > 0.25
                magnetStrength := "Moderate Pull"
            else
                magnetStrength := "Weak Pull"
        
        [strongestStrike, magnetScore, magnetStrength, pullDirection]

