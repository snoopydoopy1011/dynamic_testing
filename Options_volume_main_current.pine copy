// Enhanced collision detection function for Options labels
getOptionsLabelOffset(price, levelType, maxOffset = 20, useOffset = true) =>
    if not useOffset
        0
    else
        index = -1
        priceKey = str.tostring(price)
        
        // Search for existing price level within 1 tick tolerance
        if array.size(collisionPriceTracker) > 0
            for i = 0 to array.size(collisionPriceTracker) - 1
                if math.abs(array.get(collisionPriceTracker, i) - price) < syminfo.mintick
                    index := i
                    break
        
        if index >= 0
            // Found existing price - increment collision count
            count = array.get(collisionCountTracker, index) + 1
            array.set(collisionCountTracker, index, count)
            
            // Calculate offset using modulo to cycle through available positions
            offset = count % maxOffset
            array.set(collisionOffsetTracker, index, offset)
            offset
        else
            // New price level - add to tracking arrays
            array.push(collisionPriceTracker, price)
            array.push(collisionCountTracker, 1)
            array.push(collisionOffsetTracker, 0)
            0  // First label at this price gets offset 0

// Check if two prices are within proximity threshold
isWithinProximity(price1, price2, threshold) =>
    math.abs(price1 - price2) <= threshold

