createCollisionAwareLabel(x, y, labelText, labelType, string style = na, color labelColor = na, color textcolor = na, string size = na) =>
    // Handle default values inside the function
    actualStyle = na(style) ? label.style_none : style
    actualColor = na(labelColor) ? color.new(color.black, 100) : labelColor
    actualTextColor = na(textcolor) ? color.white : textcolor
    actualSize = na(size) ? size.small : size
    
    // Get horizontal offset to prevent collision
    offset = getOptionsLabelOffset(y, labelType)
    
    // Apply offset to x position
    adjustedX = x + offset
    
    // Create label with collision tracking
    newLabel = label.new(adjustedX, y, labelText, style = actualStyle, color = actualColor, textcolor = actualTextColor, size = actualSize)
    
    // Track this label in the collision system
    priceKey = str.tostring(y)
    if not map.contains(labelCollisionTracker, priceKey)
        newTypeMap = map.new<string, label>()
        newLabelTypeMap = LabelTypeMap.new(typeToLabel = newTypeMap)
        map.put(labelCollisionTracker, priceKey, newLabelTypeMap)
    
    labelTypeMapForPrice = map.get(labelCollisionTracker, priceKey)
    typeMapForPrice = labelTypeMapForPrice.typeToLabel
    map.put(typeMapForPrice, labelType, newLabel)
    
    newLabel

