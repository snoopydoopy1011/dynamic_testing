// Function to get top N unique non-zero values from a float array
getTopNUniqueValues(float[] arr, int n) =>
    float[] uniqueSorted = array.new_float()
    // Create a copy and sort descending
    float[] sortedCopy = array.copy(arr)
    array.sort(sortedCopy, order.descending)

    // Find unique non-zero values
    for val in sortedCopy
        if val > 0 and array.indexof(uniqueSorted, val) == -1
            array.push(uniqueSorted, val)
            if array.size(uniqueSorted) >= n
                break

    // Fill remaining slots with na if fewer than N unique values found
    while array.size(uniqueSorted) < n
        array.push(uniqueSorted, na)

    uniqueSorted // Returns an array of size N with top unique values or na

