// ==================== MATHEMATICAL FUNCTIONS ====================

// ── BS Helper Functions ────────────────────────────────────────────────
// 1) d1, d2
f_d1(S,K,r,q,o,T) =>
    (math.log(S/K) + (r - q + 0.5 * o * o) * T) / (o * math.sqrt(T))
f_d2(d1,o,T) =>
    d1 - o * math.sqrt(T)

// ── Approximate error function ─────────────────────────────
f_erf(x) =>
    // constants
    a1 = 0.254829592
    a2 = -0.284496736
    a3 = 1.421413741
    a4 = -1.453152027
    a5 = 1.061405429
    p  = 0.3275911
    sign = x < 0 ? -1 : 1
    absx = math.abs(x)
    t = 1.0 / (1.0 + p * absx)
    y = 1.0 - (((((a5 * t + a4) * t) + a3) * t + a2) * t + a1) * t * math.exp(-absx * absx)
    sign * y

// ── Standard normal CDF using erf(x/√2) ────────────────────
f_N(x) =>
    0.5 * (1.0 + f_erf(x * 0.7071067811865476))  // 1/√2 ≈ 0.70710678




// 3) Call and Put prices
f_bsCall(S,K,r,q,o,T) =>
    d1 = f_d1(S,K,r,q,o,T)
    d2 = f_d2(d1,o,T)
    S * math.exp(-q * T) * f_N(d1) - K * math.exp(-r * T) * f_N(d2)

f_bsPut(S,K,r,q,o,T) =>
    c = f_bsCall(S,K,r,q,o,T)
    c - S * math.exp(-q * T) + K * math.exp(-r * T)

// 4) ATM straddle = call+put
f_bsStraddle(S,K,r,q,o,T) =>
    f_bsCall(S,K,r,q,o,T) + f_bsPut(S,K,r,q,o,T)

// ── Implied Volatility by Bisection ────────────────────────────────────
f_ivBisection(targetPrice, S,K,r,q,T) =>
    low  = 1e-6
    high = 5.0
    mid  = 0.0
    for i = 0 to 20
        mid := (low + high) / 2
        p   = f_bsStraddle(S,K,r,q,mid,T)
        if p > targetPrice
            high := mid
        else
            low := mid
    mid

