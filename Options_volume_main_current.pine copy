// Dynamic section column allocation with overflow protection
calculateSectionColumns(totalWidth) =>
    // Input validation - handle edge cases
    if totalWidth <= 0
        [0, 0, 0, 0]
    else
        // Base column requirements for each section
        priceColsNeeded = 3     // Price Levels: POC, VAH, VAL + distance
        sentimentColsNeeded = 4 // Market Sentiment: Bias, Hedge, Consensus, Confidence  
        analyticsColsNeeded = 4 // Options Analytics: VW-DIM, Skew, IV, ImpliedMove
        flowColsNeeded = 3      // Flow Dynamics: Volume momentum, hedge momentum, net bias
        
        totalNeeded = priceColsNeeded + sentimentColsNeeded + analyticsColsNeeded + flowColsNeeded
        
        if totalWidth >= totalNeeded
            // Distribute extra columns proportionally
            extraCols = totalWidth - totalNeeded
            priceCols = priceColsNeeded + math.floor(extraCols * 0.2)
            sentimentCols = sentimentColsNeeded + math.floor(extraCols * 0.3)
            analyticsCols = analyticsColsNeeded + math.floor(extraCols * 0.3)
            flowCols = flowColsNeeded + math.floor(extraCols * 0.2)

            // Distribute any remaining columns to prevent total mismatch
            remainingCols = totalWidth - (priceCols + sentimentCols + analyticsCols + flowCols)
            if remainingCols > 0
                // Add to the largest sections first
                if remainingCols >= 2
                    sentimentCols := sentimentCols + 1
                    analyticsCols := analyticsCols + 1
                    remainingCols := remainingCols - 2
                if remainingCols > 0
                    sentimentCols := sentimentCols + remainingCols
            
            [priceCols, sentimentCols, analyticsCols, flowCols]
        else
            // Compress sections proportionally with minimum viable columns
            priceCols = math.max(2, math.floor(totalWidth * 0.2))
            sentimentCols = math.max(3, math.floor(totalWidth * 0.3))
            analyticsCols = math.max(3, math.floor(totalWidth * 0.3))
            flowCols = math.max(2, math.floor(totalWidth * 0.2))

            // Handle overflow: reduce largest sections if sum exceeds totalWidth
            summedCols = priceCols + sentimentCols + analyticsCols + flowCols
            if summedCols > totalWidth
                diff = summedCols - totalWidth
                // Reduce sentiment first (largest), then analytics
                if sentimentCols > 3 and diff > 0
                    reduction = math.min(diff, sentimentCols - 3)
                    sentimentCols := sentimentCols - reduction
                    diff := diff - reduction
                if analyticsCols > 3 and diff > 0
                    reduction = math.min(diff, analyticsCols - 3)
                    analyticsCols := analyticsCols - reduction
                    diff := diff - reduction
                if priceCols > 2 and diff > 0
                    reduction = math.min(diff, priceCols - 2)
                    priceCols := priceCols - reduction
                    diff := diff - reduction
                if flowCols > 2 and diff > 0
                    reduction = math.min(diff, flowCols - 2)
                    flowCols := flowCols - reduction

            // CRITICAL FIX: Ensure minimums are still met after reduction
            priceCols := math.max(2, priceCols)
            sentimentCols := math.max(3, sentimentCols)
            analyticsCols := math.max(3, analyticsCols)
            flowCols := math.max(2, flowCols)
            
            [priceCols, sentimentCols, analyticsCols, flowCols]

// Calculate section starting columns based on allocated widths
calculateSectionStarts(priceCols, sentimentCols, analyticsCols, flowCols) =>
    priceStart = 0
    sentimentStart = priceStart + priceCols
    analyticsStart = sentimentStart + sentimentCols
    flowStart = analyticsStart + analyticsCols
    [priceStart, sentimentStart, analyticsStart, flowStart]

